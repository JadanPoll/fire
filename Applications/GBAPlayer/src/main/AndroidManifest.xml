<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <application android:label="Fire GBA" android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@drawable/tv_icon" android:banner="@drawable/tv_banner"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".GbaGameActivity" android:exported="false"
            android:screenOrientation="landscape"/>
        <activity android:name=".GbaLibraryActivity" android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
