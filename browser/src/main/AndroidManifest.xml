<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <application android:label="Fire Browser" android:icon="@drawable/browser_icon"
        android:banner="@drawable/browser_banner" android:allowBackup="false"
        android:usesCleartextTraffic="false" android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".BrowserActivity" android:exported="true"
            android:banner="@drawable/browser_banner" android:icon="@drawable/browser_icon"
            android:launchMode="singleTask" android:alwaysRetainTaskState="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
    </application>
</manifest>
